{
  "keymap": "tmux",
  "keymap_prefix": "ctrl+a",
  "theme": "System",
  "theme_light": "light-gruvbox",
  "theme_dark": "dark-rose-pine",
  "confirm_close": "always",
  "status_bar": true,
  "agent_command": "claude",
  "new_blocks": "Shell",
  "keybinds": {
    "ctrl+a>t": "new_tab",
    "ctrl+a>|": "split_right",
    "ctrl+a>shift+\\": "split_right",
    "ctrl+a>-": "split_down",
    "ctrl+a>h": "focus_pane:left",
    "ctrl+a>j": "focus_pane:down",
    "ctrl+a>k": "focus_pane:up",
    "ctrl+a>l": "focus_pane:right",
    "ctrl+a>e": "plugin.kit.popup_editor",
    "ctrl+a>g": "plugin.kit.popup_lazygit",
    "ctrl+a>p": "plugin.kit.popup_shell",
    "ctrl+a>@": "plugin.kit.copy_pane_id",
    "ctrl+a>shift+2": "plugin.kit.copy_pane_id",
    "ctrl+a>y": "plugin.kit.copy_session_id",
    "ctrl+a>shift+y": "plugin.kit.copy_tab_id",
    "ctrl+a>shift+h": "move_pane:left",
    "ctrl+a>shift+j": "move_pane:down",
    "ctrl+a>shift+k": "move_pane:up",
    "ctrl+a>shift+l": "move_pane:right",
    "ctrl+a>space": "show_previous_tab",
    "ctrl+a>s": "plugin.kit.pick_session",
    "ctrl+a>w": "switch_session",
    "ctrl+a>n": "new_session",
    "ctrl+a>shift+x": "close_session",
    "ctrl+a>shift+e": "open_scrollback",
    "ctrl+a><": "preferences",
    "ctrl+a>shift+,": "preferences",
    "ctrl+a>shift+r": "reload_config",
    "ctrl+a>o": "plugin.kit.pick_file",
    "ctrl+h": "plugin.kit.nav_left",
    "ctrl+j": "plugin.kit.nav_down",
    "ctrl+k": "plugin.kit.nav_up",
    "ctrl+l": "plugin.kit.nav_right"
  }
}
